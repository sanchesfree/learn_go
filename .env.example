# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=booking
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Server
HTTP_ADDR=0.0.0.0
HTTP_PORT=8080

# Auth
JWT_SECRET=local-dev-secret-change-me

# Worker
WORKER_INTERVAL=1m

# External API (для HTTP-клиента)
NOTIFY_API_URL=http://localhost:9999/notify
